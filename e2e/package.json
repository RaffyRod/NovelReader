{
  "name": "quicknovel-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "WebdriverIO + Appium E2E for QuickNovel Ultimate (Android)",
  "scripts": {
    "appium:driver": "appium driver install uiautomator2 || true",
    "test": "wdio run ./wdio.conf.js",
    "test:local": "wdio run ./wdio.conf.js",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open"
  },
  "devDependencies": {
    "@wdio/allure-reporter": "^9.16.2",
    "@wdio/appium-service": "^9.16.2",
    "@wdio/cli": "^9.16.2",
    "@wdio/local-runner": "^9.16.2",
    "@wdio/mocha-framework": "^9.16.2",
    "@wdio/spec-reporter": "^9.16.2",
    "allure-commandline": "^2.34.0",
    "appium": "^2.19.0",
    "appium-uiautomator2-driver": "^4.2.3",
    "expect-webdriverio": "^6.0.9"
  },
  "engines": {
    "node": ">=18"
  }
}
