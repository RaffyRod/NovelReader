{
  "name": "quicknovel-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "WebdriverIO + Appium E2E for QuickNovel Ultimate (Android)",
  "scripts": {
    "appium:driver": "appium driver install uiautomator2 || true",
    "providers:generate": "node ./scripts/generate-providers.js",
    "providers:probe": "npm run providers:generate && node ./scripts/probe-providers.js",
    "test": "wdio run ./wdio.conf.js",
    "test:local": "wdio run ./wdio.conf.js",
    "test:smoke": "wdio run ./wdio.conf.js --suite smoke",
    "test:features": "wdio run ./wdio.conf.js --suite features",
    "test:plugins": "wdio run ./wdio.conf.js --spec ./test/specs/10-plugins.e2e.js",
    "test:download-translate": "wdio run ./wdio.conf.js --spec ./test/specs/11-download-translate.e2e.js",
    "test:sections": "wdio run ./wdio.conf.js --spec ./test/specs/14-sections-translations.e2e.js",
    "test:reader": "wdio run ./wdio.conf.js --suite reader",
    "test:theme": "wdio run ./wdio.conf.js --spec ./test/specs/13-theme-defaults.e2e.js",
    "test:reader-loading": "wdio run ./wdio.conf.js --spec ./test/specs/12-reader-loading.e2e.js",
    "test:providers": "npm run providers:generate && wdio run ./wdio.conf.js --suite providers",
    "ci:local": "npm run providers:generate && wdio run ./wdio.conf.js --suite smoke && wdio run ./wdio.conf.js --suite features && wdio run ./wdio.conf.js --suite providers",
    "pretest": "npm run providers:generate",
    "pretest:smoke": "npm run providers:generate",
    "pretest:features": "npm run providers:generate",
    "pretest:reader": "npm run providers:generate",
    "pretest:sections": "npm run providers:generate",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open"
  },
  "devDependencies": {
    "@wdio/allure-reporter": "^9.16.2",
    "@wdio/appium-service": "^9.16.2",
    "@wdio/cli": "^9.16.2",
    "@wdio/local-runner": "^9.16.2",
    "@wdio/mocha-framework": "^9.16.2",
    "@wdio/spec-reporter": "^9.16.2",
    "allure-commandline": "^2.34.0",
    "appium": "^2.19.0",
    "appium-uiautomator2-driver": "^4.2.3",
    "expect-webdriverio": "^6.0.9"
  },
  "engines": {
    "node": ">=18"
  }
}
