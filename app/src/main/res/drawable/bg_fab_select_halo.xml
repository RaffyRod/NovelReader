<?xml version="1.0" encoding="utf-8"?>
<!-- Halo ring (style J): soft outer bloom + stroked core. Uses theme colorPrimary. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft outer halo -->
    <item android:alpha="0.18">
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="7dp"
                android:color="?attr/colorPrimary" />
            <size
                android:width="56dp"
                android:height="56dp" />
        </shape>
    </item>
    <!-- Core disc + primary ring -->
    <item
        android:bottom="5dp"
        android:left="5dp"
        android:right="5dp"
        android:top="5dp">
        <shape android:shape="oval">
            <solid android:color="?attr/primaryBlackBackground" />
            <stroke
                android:width="2dp"
                android:color="?attr/colorPrimary" />
        </shape>
    </item>
</layer-list>
