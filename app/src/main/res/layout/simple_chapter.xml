<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:backgroundTint="?attr/primaryBlackBackground"
        android:layout_marginBottom="5dp"
        android:layout_width="match_parent"
        app:cardCornerRadius="0dp"
        android:foreground="?android:attr/selectableItemBackgroundBorderless"
        android:layout_height="50dp">

    <LinearLayout
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <CheckBox
                android:id="@+id/select_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:visibility="gone"
                tools:visibility="visible" />

        <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent">

            <TextView
                    android:ellipsize="marquee"
                    android:singleLine="true"
                    tools:textSize="16sp"
                    tools:textColor="?attr/textColor"
                    android:layout_gravity="center"
                    tools:text="Chapter 1"
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            <TextView
                    tools:textSize="14sp"
                    tools:textColor="?attr/grayTextColor"
                    android:layout_gravity="center"
                    tools:text="Released 10h ago"
                    android:id="@+id/release_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

            </TextView>
        </LinearLayout>

        <ImageView
                android:id="@+id/last_marker"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/last_chapter_title"
                android:src="@drawable/ic_baseline_flag_24"
                android:visibility="gone"
                app:tint="?attr/colorPrimary"
                tools:visibility="visible" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
