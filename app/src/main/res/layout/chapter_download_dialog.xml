<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/download_format"
            android:textColor="?attr/grayTextColor"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/download_format"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/format_epub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:minHeight="48dp"
                android:text="@string/format_epub"
                android:textColor="?attr/textColor" />

            <RadioButton
                android:id="@+id/format_pdf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/format_pdf"
                android:textColor="?attr/textColor" />

            <RadioButton
                android:id="@+id/format_chapters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/format_chapters_only"
                android:textColor="?attr/textColor" />
        </RadioGroup>

        <TextView
            android:id="@+id/download_chapters_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="?attr/grayTextColor"
            android:textSize="13sp"
            tools:text="Chapters (1-50)" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:backgroundTint="?attr/iconGrayBackground"
            app:cardCornerRadius="@dimen/roundedImageRadius">

            <EditText
                android:id="@+id/download_chapters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/download_chapters_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:minHeight="48dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="?attr/textColor" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:id="@+id/download_per_file_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/download_per_file"
                android:textColor="?attr/grayTextColor"
                android:textSize="13sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/download_per_file_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="false"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="?attr/iconGrayBackground"
                app:cardCornerRadius="@dimen/roundedImageRadius">

                <EditText
                    android:id="@+id/download_per_file"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/download_per_file_hint"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:minHeight="48dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="?attr/textColor" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/download_translate_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/download_translate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/download_translate"
                android:textColor="?attr/textColor" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="32dp"
                android:paddingEnd="0dp"
                android:text="@string/download_translate_hint"
                android:textColor="?attr/grayTextColor"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/download_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="?attr/textColor"
            android:textSize="14sp"
            tools:text="3 chapters, 1 file" />

        <TextView
            android:id="@+id/download_ranges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/grayTextColor"
            android:textSize="13sp"
            tools:text="1-50 · 51-100 · 101-109" />
    </LinearLayout>
</ScrollView>
